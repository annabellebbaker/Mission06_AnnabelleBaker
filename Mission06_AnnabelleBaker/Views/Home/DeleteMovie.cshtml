@{
}


@model Movie
<h2>Confirm Deletion</h2>
<h3>@Model.Title by @Model.Director</h3>

<form method="post">
    <input type="hidden" asp-for="MovieId" />
    <button style="text-align: center;" type="submit">Delete</button>
    <a class="btn btn-info" style="text-align: center;" asp-controller="Home" asp-action="MovieList">Cancel</a>
</form>